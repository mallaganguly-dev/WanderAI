# Copy this file to .env for local development. Never commit real secrets.
GEMINI_API_KEY=your_gemini_api_key_here

# Use a long random value for SECRET_KEY.
SECRET_KEY=replace_with_random_secret

# Create your first admin account with your own email and a strong password.
MAIN_ADMIN_EMAIL=you@example.com
MAIN_ADMIN_PASSWORD=replace_with_a_strong_password
